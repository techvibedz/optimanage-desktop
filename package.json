{
  "name": "optimanage-desktop",
  "version": "1.6.4",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder build --win",
    "publish": "vite build && electron-builder build --win --publish always",
    "ci:install": "npm ci --ignore-scripts",
    "ci:build": "npm ci --ignore-scripts && vite build && electron-builder build --win",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.optimanage.desktop",
    "productName": "OptiManage Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": ".prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@prisma",
        "to": "@prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "prisma",
        "to": "prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": ".env.production",
        "to": ".env.production"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "techvibedz",
      "repo": "optimanage-desktop"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-tooltip": "1.1.6",
    "@sentry/electron": "7.13.0",
    "@supabase/supabase-js": "2.49.1",
    "@tanstack/react-table": "8.20.6",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "12.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "3.6.0",
    "electron-updater": "6.8.3",
    "framer-motion": "12.4.0",
    "jsbarcode": "3.12.3",
    "jspdf": "2.5.2",
    "lucide-react": "0.454.0",
    "pino": "10.3.1",
    "prisma": "5.22.0",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-day-picker": "8.10.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.15.0",
    "sonner": "1.7.1",
    "tailwind-merge": "2.5.5",
    "tailwindcss-animate": "1.0.7",
    "ws": "8.20.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "pino-pretty": "13.1.3",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "6.0.3",
    "vite-plugin-electron": "0.28.8",
    "vite-plugin-electron-renderer": "0.14.6",
    "vitest": "^2.1.9",
    "wait-on": "8.0.1"
  }
}
